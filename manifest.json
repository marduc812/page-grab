{
  "manifest_version": 3,
  "name": "Full Page Capture",
  "version": "1.2.0",
  "description": "Capture an entire page, then copy or save it as PNG, JPG, WebP, or PDF.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture full page as image",
    "default_icon": {
      "16": "icons/pagegrab16.png",
      "32": "icons/pagegrab32.png"
    }
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture full page as image"
    }
  },
  "icons": {
    "16": "icons/pagegrab16.png",
    "32": "icons/pagegrab32.png",
    "48": "icons/pagegrab48.png",
    "128": "icons/pagegrab128.png"
  }
}
